{
  "realm": "nextu-files",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard file share user",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ADMIN",
        "description": "Administrator",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": ["USER"],
  "clients": [
    {
      "clientId": "gateway-client",
      "name": "BFF Gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "gateway-client-secret",
      "redirectUris": [
        "http://localhost:8090/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8090",
        "http://localhost:5173"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "storage-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "nextu-files-storage",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-cli-service",
      "name": "Admin CLI Service Account",
      "enabled": true,
      "publicClient": false,
      "secret": "admin-cli-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@nextu.fr",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Martin",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@nextu.fr",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Durand",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin.smith",
      "enabled": true,
      "email": "admin.smith@nextu.fr",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Smith",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "USER"]
    },
    {
      "username": "service-account-admin-cli-service",
      "enabled": true,
      "serviceAccountClientId": "admin-cli-service",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
