# Set (any non-empty value) to show the "S'inscrire" link on the login page.
# The link always points to the BFF's own /oauth2/authorization/keycloak-register endpoint
# (see backend/bff-gateway/src/main/resources/application.yml) so Spring Security can
# validate the OAuth2 callback — it does not use this value as a literal URL.
VITE_KEYCLOAK_REGISTRATION_URL=http://localhost:8180/realms/nextu-files/protocol/openid-connect/registrations
